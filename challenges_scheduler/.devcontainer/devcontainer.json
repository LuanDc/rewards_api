{
  "name": "Challenges Scheduler",
  "dockerComposeFile": ["../../docker-compose.dev.yml"],
  "service": "challenges_scheduler",
  "workspaceFolder": "/workspace/challenges_scheduler",
  "forwardPorts": [4000],
  "postCreateCommand": "mix deps.get && mix ecto.setup && mix run priv/repo/seeds.exs",
  "customizations": {
    "vscode": {
      "extensions": [
        "JakeBecker.elixir-ls",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[elixir]": {
          "editor.defaultFormatter": "JakeBecker.elixir-ls"
        }
      }
    }
  }
}
